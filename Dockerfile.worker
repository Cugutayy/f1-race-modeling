FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    F1_MODEL_EVIDENCE_PATH=/models/model_evidence.json

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY reports/local/model_evidence.json /models/model_evidence.json

RUN python -c "import json,pathlib; p=pathlib.Path('/models/model_evidence.json'); d=json.loads(p.read_text()); r=d.get('model_release'); assert d.get('schema_version') == 1; assert d.get('evidence_kind') == 'retrospective_sealed_historical_benchmark'; assert isinstance(d.get('sealed_test_events'), int) and d['sealed_test_events'] > 0; assert isinstance(r, dict); assert len(str(r.get('git_sha',''))) in (40,64); assert all(len(str(r.get(k,''))) == 64 for k in ('model_sha256','model_manifest_sha256','feature_schema_sha256','training_data_sha256','calibration_sha256'))" \
    && python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir ".[live,api]" \
    && useradd --create-home --uid 10001 f1 \
    && mkdir -p /data/live /models \
    && chown -R f1:f1 /data /models /app

USER f1

EXPOSE 8000

CMD ["f1-api"]
